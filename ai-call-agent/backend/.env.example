# ==============================================================================
# AI Call Agent - Production Environment Variable Reference (Stages 1–10)
# ==============================================================================

# Application & Operational Settings
APP_NAME=ai-call-agent-backend
ENVIRONMENT=production                       # production | staging | development
DEBUG=false                                  # Must be false in production
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR

# Security & Access Control
# IMPORTANT: Generate a strong secret with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=https://dashboard.yourcompany.com,https://api.yourcompany.com

# Database Connectivity (PostgreSQL / Neon)
# Connection pool settings enforced by SQLAlchemy pooler
DATABASE_URL=postgresql://user:password@ep-sample-123456.ap-south-1.aws.neon.tech/callagent_db?sslmode=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Telephony Integration (Twilio / PSTN / SIP Trunking)
# Providers: mock | twilio | exotel
TELEPHONY_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+911140000000
TELEPHONY_WEBHOOK_URL=https://api.yourcompany.com/api/v1/telephony/webhook
TELEPHONY_WEBHOOK_SECRET=your_twilio_webhook_signing_secret
DEFAULT_FORWARD_NUMBER=+919876543210

# Voice AI, Speech Recognition (STT) & Synthesis (TTS)
# Providers: mock | ollama | openai_realtime | xtts
VOICE_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama-inference-service:11434
OLLAMA_MODEL=llama3:8b
STT_PROVIDER=whisper_local                    # whisper_local | google_stt | deepgram
TTS_PROVIDER=local_tts                        # local_tts | polly | xtts_v2
DEFAULT_VOICE_ID=aditi_bilingual_in

# Spam & Fraud Screening Engine
SPAM_ENGINE_PROVIDER=hybrid_rules
SPAM_THRESHOLD_BLOCK=70
SPAM_THRESHOLD_UNCERTAIN=40

# File Storage & Report Persistence
REPORT_STORAGE_DIR=/app/storage/reports
PRIVATE_STORAGE_DRIVER=local                 # local | s3 | gcs

# Scheduled Report Delivery & SMTP Setup
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@yourcompany.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_ADDRESS=reports@yourcompany.com
SMTP_USE_TLS=true
